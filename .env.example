# このファイルを .env という名前でコピーして、値を書き込んでください。
# 書き方と注意は docs/setup.md にあります。.env は他人に見せないでください。

# ===== 必ず設定する =====

# このサーバを開くアドレス（https から。末尾の / は付けない）。例: https://digest.example.com
APP_URL=

# ログインを守るための、でたらめな長い文字列。作り方の例: openssl rand -hex 32
SESSION_SECRET=

# データベースのパスワード。英数字だけで、長めに。最初に立ち上げたあとは変えない
POSTGRES_PASSWORD=

# 最初の管理者になる人のメールアドレス。このアドレスの人だけが最初の登録をできる（登録にはサーバのログに出る初期設定コードも要る）
INITIAL_ADMIN_EMAIL=

# Anthropic の API キー。紙面の編集・要約・編集長への相談・深掘りに使う
ANTHROPIC_API_KEY=

# ===== 任意の機能（キーが無い機能は画面に出ない） =====

# Gemini の API キー（請求先を紐づけた有料枠のもの）。音声版に使う
GEMINI_API_KEY=

# Resend の API キー。朝刊のメール配信・パスワード再設定のメールなどに使う
RESEND_API_KEY=
# メールの送り主。Resend で確認済みのドメインのアドレスにする。例: digest@example.co.jp
FROM_EMAIL=

# Google ログインを使うときの OAuth クライアント ID（ウェブ アプリケーション用）
GOOGLE_CLIENT_ID=

# ===== 立ち上げ方 =====

# 同梱の Caddy で https にするとき、APP_URL と同じホスト名。例: digest.example.com
DOMAIN=
# アプリの待ち受け先。既定は 127.0.0.1（このサーバの中からだけ）。http で直接開くときは 0.0.0.0
APP_BIND=
# アプリの待ち受けポート。既定は 3000
APP_PORT=
# 前に置いた中継サーバ（Caddy・nginx など）の段数。既定は 1。中継が2段なら 2、中継が無ければ false
TRUST_PROXY=
# https を使わずに http で開くときだけ true（外から届かない閉じたネットワークでの試用向け）
ALLOW_HTTP=

# ===== 画面の表示 =====

# 画面に出すアプリの名前。空なら AI RSS Digest
APP_NAME=
# 画面に出す運営者の名前。例: 株式会社サンプル
ORGANIZATION_NAME=
# 問い合わせ先として画面に出すメールアドレス
SUPPORT_EMAIL=
# 利用規約・プライバシーポリシーのページのアドレス（あれば画面の下にリンクを出す）
TERMS_URL=
PRIVACY_URL=

# ===== 運用 =====
# ここから下は、変えたい項目だけ行頭の「# 」を外して値を書いてください（空のまま外すと意図しない値になる項目があります）。

# データベースの容量の警告や音声版の削除を知らせるメールの宛先（Resend が要る）
# OPS_EMAIL=ops@example.co.jp
# 音声版の音声ファイルを残す日数。既定は 180。0 にすると消さない
# PODCAST_RETENTION_DAYS=180
# データベースの大きさがこれを超えたら警告する（バイト）。既定は 8589934592（8GB）
# DB_WARN_BYTES=8589934592
# 毎時の記事集め・朝刊づくりなどの自動処理を止めるときだけ false
# DIGEST_SCHEDULER_ENABLED=false

# ===== ログインの有効期間 =====

# 画面を操作しないまま、ログインが切れるまでの分数。既定は 60
# WEB_SESSION_IDLE_MINUTES=60
# 操作していても、ログインし直しになるまでの分数。既定は 720
# WEB_SESSION_ABSOLUTE_MINUTES=720
# 管理画面を操作しないまま、管理者の確認が切れるまでの分数。既定は 15
# ADMIN_SESSION_IDLE_MINUTES=15
# パスワードを入れ直したあと、大事な操作を続けてできる分数。既定は 10
# SUDO_WINDOW_MINUTES=10

# ===== 紙面づくりの調整（ふつうは変えない） =====

# 朝刊に載せる記事を探す範囲（時間）。既定は 24
# DIGEST_WINDOW_HOURS=24
# 同じ話題の記事をまとめるときに見る範囲（時間）。既定は 72
# CLUSTER_WINDOW_HOURS=72
# 1号で AI が読む記事の上限。既定は 1000
# TRIAGE_LIMIT=1000
# これまでの号に載った話題を、新しい号から外す。外さないときだけ false
# DEDUPE_AGAINST_PUBLISHED=false
# Googleニュースの検索フィードを続けて読むときの間隔（ミリ秒）。既定は 2500
# DIGEST_GNEWS_DELAY_MS=2500
# 紙面の見直し（記事と元記事の照合）にかける時間の上限（ミリ秒）。既定は 180000
# DIGEST_PROOFREAD_BUDGET_MS=180000
# サーバ全体で同時に動かす重い処理の数。既定は 3
# DIGEST_MAX_CONCURRENT_JOBS=3
# 1人あたり同時に動かす重い処理の数。既定は 2
# DIGEST_MAX_JOBS_PER_USER=2

# ===== AI のモデル（ふつうは変えない。書かなければ決められたモデルを使う） =====

# 記事のふるい分け用
# DIGEST_TRIAGE_MODEL=
# 同じ話題の判定用（書かなければふるい分けと同じ）
# DIGEST_DEDUPE_MODEL=
# 紙面を書く用
# DIGEST_GENERATE_MODEL=
# 紙面を書くときの考える深さ（low・medium・high・xhigh・max）。既定は medium
# DIGEST_EDITION_EFFORT=medium
# 特に丁寧に考える場面の用
# DIGEST_PREMIUM_MODEL=
# 深掘りの用（書かなければ紙面を書くのと同じ）
# DIGEST_RESEARCH_MODEL=
# 深掘りの図解の用（書かなければ紙面を書くのと同じ）
# DIGEST_VISUAL_MODEL=
# 音声版の台本を書く用（書かなければ紙面を書くのと同じ）
# DIGEST_PODCAST_SCRIPT_MODEL=
# 音声版の台本を書くときの考える深さ（low・medium・high・xhigh・max）。既定は medium
# DIGEST_PODCAST_SCRIPT_EFFORT=medium
# 音声版の読み上げ用（Gemini）
# DIGEST_TTS_MODEL=
# 音声版で人名の読み方を確かめる用（Gemini）
# DIGEST_TTS_CHECK_MODEL=
# 人名の読み方の確認をしないときだけ false
# DIGEST_TTS_READING_CHECK=false
# 音声版の2人の声の名前（Gemini の声の名前）。既定は Kore と Charon
# DIGEST_PODCAST_VOICE_A=Kore
# DIGEST_PODCAST_VOICE_B=Charon
# 音声版の読み上げを同時に頼む数。既定は 3
# DIGEST_TTS_CONCURRENCY=3
# Anthropic の API の送り先を変えるとき
# DIGEST_ANTHROPIC_API_URL=

# ===== 操作の記録（任意） =====

# 操作の記録をデータベースに残す日数。365 以上を指定。既定は 400
# AUDIT_DB_RETENTION_DAYS=400
# 操作の記録を毎日 Cloudflare R2 にも写すときの設定（4つそろったときだけ写す）
# AUDIT_R2_ACCOUNT_ID=
# AUDIT_R2_ACCESS_KEY_ID=
# AUDIT_R2_SECRET_ACCESS_KEY=
# AUDIT_R2_BUCKET=
# R2 に写すときのフォルダ名に入れる環境の名前。書かなければ local
# AUDIT_R2_ENV=production

# ===== Docker を使わずに動かすとき・開発用 =====

# データベースの接続先。Docker では docker-compose.yml が自動で入れるので書かない
# DATABASE_URL=
# 外部のデータベースに暗号化して接続するときだけ true
# DATABASE_SSL=true
# ffmpeg の場所。Docker のイメージには入っているので書かない
# FFMPEG_PATH=/usr/bin/ffmpeg
# 開発用の画面のアドレス。既定は http://localhost:5173
# CLIENT_URL=http://localhost:5173
# 画面の安全のための制限（CSP）を、止めずに報告だけにするときだけ 0
# CSP_ENFORCE=0
# 起動時のデータベースの点検で問題があっても起動するときだけ false（常用しない）
# SCHEMA_AUDIT_ENFORCE=false
